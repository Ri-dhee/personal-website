{
  "name": "profile-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "tsc -b && vite build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name rinzin-site",
    "deploy:worker": "wrangler deploy --config wrangler-worker.toml"
  },
  "dependencies": {
    "lenis": "^1.3.23",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.0.12",
    "vitest": "^2.1.8",
    "wrangler": "^4.86.0"
  }
}
